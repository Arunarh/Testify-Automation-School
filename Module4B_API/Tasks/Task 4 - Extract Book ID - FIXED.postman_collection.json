    {
      "name": "Get Non-Fiction Books - Untamed ID Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Untamed has ID 5\", function () {\r",
              "    const books = pm.response.json();\r",
              "    const untamed = books.find(book => book.name === \"Untamed\");\r",
              "    pm.expect(untamed.id).to.eql(5);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?type=non-fiction",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "type",
              "value": "non-fiction"
            }
          ]
        }
      },
      "response": []
